<Window x:Class="Astrarium.Plugins.Notes.Views.AllNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Astrarium.Plugins.Notes.Views"
        xmlns:a="Astrarium"
        Style="{StaticResource {x:Type Window}}"
        Title="{a:Text Notes.NotesWindow.Title}" Height="450" Width="800">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:NotesControl Grid.Row="0" DataContext="{Binding}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button Margin="0 4 4 4" Padding="8 2" MinWidth="100" Content="{a:Text Close}" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
