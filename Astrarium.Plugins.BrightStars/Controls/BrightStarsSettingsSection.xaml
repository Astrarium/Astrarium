<a:SettingsSection 
    x:Class="Astrarium.Plugins.BrightStars.Controls.BrightStarsSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:a="Astrarium"
    Title="{a:Text Section.Stars}"
    Icon="{StaticResource IconStar}"
    mc:Ignorable="d"
    d:DesignHeight="450" 
    d:DesignWidth="800">

    <StackPanel Orientation="Vertical" Margin="6">
        <CheckBox Content="{a:Text Settings.Stars}" IsChecked="{Binding Settings.Stars}" Margin="2" />
        <CheckBox Content="{a:Text Settings.StarsLabels}" IsChecked="{Binding Settings.StarsLabels}" IsEnabled="{Binding Settings.Stars}" Margin="2" />
        <CheckBox Content="{a:Text Settings.StarsProperNames}" IsChecked="{Binding Settings.StarsProperNames}" Margin="2">
            <CheckBox.IsEnabled>
                <MultiBinding Converter="{a:BooleanAndConverter}">
                    <Binding Path="Settings.Stars" />
                    <Binding Path="Settings.StarsLabels" />
                </MultiBinding>
            </CheckBox.IsEnabled>
        </CheckBox>
        <CheckBox Content="{a:Text Settings.StarsColors}" IsChecked="{Binding Settings.StarsColors}" IsEnabled="{Binding Settings.Stars}" Margin="2" />
    </StackPanel>
</a:SettingsSection>
