<a:SettingsSection 
    x:Class="Astrarium.Plugins.Supernovae.Controls.SupernovaeSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="Astrarium"
    Title="{a:Text Section.Supernovae}"
    Icon="{StaticResource IconSupernova}">
    <StackPanel Orientation="Vertical" Margin="6">
        <CheckBox Content="{a:Text Settings.Supernovae}" IsChecked="{Binding Settings.Supernovae}" Margin="2" />
        <StackPanel Orientation="Vertical" IsEnabled="{Binding Settings.Supernovae}">
            <CheckBox Content="{a:Text Settings.SupernovaeLabels}" IsChecked="{Binding Settings.SupernovaeLabels}" Margin="2" />
            <CheckBox Content="{a:Text Settings.SupernovaeDrawAll}" IsChecked="{Binding Settings.SupernovaeDrawAll}" Margin="2" />
        </StackPanel>
    </StackPanel>
</a:SettingsSection>
