<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:a="Astrarium" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Astrarium.Plugins.FOV" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    x:Class="Astrarium.Plugins.FOV.BinocularWindow" 
    mc:Ignorable="d" 
    Title="{a:Text BinocularWindow.Title}" 
    Height="300" 
    Width="300" 
    MinHeight="300" MinWidth="300" 
    Style="{StaticResource {x:Type Window}}" 
    WindowStartupLocation="CenterOwner">

    <Grid Margin="4" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="6">
            <Label Content="{a:Text BinocularWindow.Name}" />
            <TextBox Text="{Binding Binocular.Name}" />

            <Label Content="{a:Text BinocularWindow.Aperture}" />
            <a:NumericUpDown Value="{Binding Binocular.Aperture}" DecimalPlaces="0" Minimum="1" Maximum="10000" />

            <Label Content="{a:Text BinocularWindow.Magnification}" />
            <a:NumericUpDown Value="{Binding Binocular.Magnification}" DecimalPlaces="0" Minimum="1" Maximum="10000" />

            <Label Content="{a:Text BinocularWindow.FieldOfView}" />
            <a:NumericUpDown Value="{Binding Binocular.FieldOfView}" DecimalPlaces="2" Minimum="1" Maximum="10000" Step="1" />

        </StackPanel>

        <Separator Grid.Row="1" Margin="0 4 0 4" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="80" Width="Auto" Margin="4 0 0 0" Padding="8 2" Command="{Binding OkCommand}" Content="{a:Text OK}" />
            <Button MinWidth="80" Width="Auto" Margin="4 0 0 0" Padding="8 2" Command="{Binding CancelCommand}" Content="{a:Text Cancel}" />
        </StackPanel>
    </Grid>
</Window>