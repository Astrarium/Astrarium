                </Grid>
            </GroupBox>

        </StackPanel>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="80" Width="Auto" Margin="4 0 0 0" Padding="8 2" Command="{Binding OkCommand}" Content="{a:Text OK}" IsEnabled="{Binding FieldOfView, Converter={a:NotNullToBoolConverter}}" />
            <Button MinWidth="80" Width="Auto" Margin="4 0 0 0" Padding="8 2" Command="{Binding CancelCommand}" Content="{a:Text Cancel}" />
        </StackPanel>
    </Grid>
