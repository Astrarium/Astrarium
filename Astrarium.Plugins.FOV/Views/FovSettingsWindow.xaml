            <!-- Details -->
            <GroupBox Header="{a:Text FovSettingsWindow.Details}" Visibility="{Binding FinderVisible, Converter={a:InverseBoolToVisibilityConverter}}" Margin="2 8 2 8">
                <Grid>
                    <TextBlock Margin="2 8 2 8" TextWrapping="Wrap" Text="{Binding FieldOfView, Mode=OneWay, Converter={local:FieldOfViewDetailsConverter}}" Visibility="{Binding FieldOfView, Converter={a:NotNullToVisibilityConverter}}" />
