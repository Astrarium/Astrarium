<a:SettingsSection 
    x:Class="Astrarium.Plugins.Tycho2.Controls.Tycho2SettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="Astrarium"
    Title="{a:Text Section.Tycho2}"
    Icon="{StaticResource IconTycho2Star}">
    <StackPanel Orientation="Vertical" Margin="6" IsEnabled="{Binding IsEnabled}">
        <CheckBox Content="{a:Text Settings.Tycho2}" IsChecked="{Binding Settings.Tycho2}" Margin="2" />

        <StackPanel Orientation="Vertical" IsEnabled="{Binding Settings.Tycho2}">
            <TextBlock Margin="2 8 2 2" Text="{a:Text Settings.Tycho2.RootDir.Title}" />
            <a:FilePathPicker Caption="{a:Text Settings.Tycho2.RootDir.DialogCaption}" Mode="Directory" SelectedPath="{Binding Settings.Tycho2RootDir}" Validator="{Binding ValidateCatalogPath}" />

            <StackPanel Orientation="Vertical" Visibility="{Binding Catalog.IsLoaded, Converter={a:InverseBoolToVisibilityConverter}}">
                <TextBlock Margin="2 8 2 2" TextWrapping="Wrap" Text="{a:Text Settings.Tycho2.NotFound}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{a:Text Tycho2.DownloadAutoButton}" Command="{Binding DownloadCatalogCommand}" MinWidth="100" Padding="8 0" Margin="0 8 0 0" Width="Auto" HorizontalAlignment="Left" />
                    <Button Content="{a:Text Tycho2.DownloadManualButton}" Command="{Binding OpenCatalogUrlCommand}" MinWidth="100" Padding="8 0" Margin="4 8 0 0" Width="Auto" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{a:Text Settings.Tycho2.Loaded}" Visibility="{Binding Catalog.IsLoaded, Converter={a:BoolToVisibilityConverter}}" Margin="2 8 2 2" TextWrapping="Wrap" />

        </StackPanel>
    </StackPanel>
</a:SettingsSection>
