<a:SettingsSection 
    x:Class="Astrarium.Plugins.Novae.Controls.NovaeSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="Astrarium"
    Title="{a:Text Section.Novae}"
    Icon="{StaticResource IconNova}">
    <StackPanel Orientation="Vertical" Margin="6">
        <CheckBox Content="{a:Text Settings.Novae}" IsChecked="{Binding Settings.Novae}" Margin="2" />
        <StackPanel Orientation="Vertical" IsEnabled="{Binding Settings.Novae}">
            <CheckBox Content="{a:Text Settings.NovaeLabels}" IsChecked="{Binding Settings.NovaeLabels}" Margin="2" />
            <CheckBox Content="{a:Text Settings.NovaeDrawAll}" IsChecked="{Binding Settings.NovaeDrawAll}" Margin="2" />
        </StackPanel>
    </StackPanel>
</a:SettingsSection>
