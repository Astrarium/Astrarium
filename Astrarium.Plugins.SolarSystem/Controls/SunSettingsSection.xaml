<a:SettingsSection 
    x:Class="Astrarium.Plugins.SolarSystem.Controls.SunSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="Astrarium"
    Title="{a:Text Section.Sun}"
    Icon="{StaticResource IconSun}">
    <StackPanel Orientation="Vertical" Margin="6">
        <CheckBox Content="{a:Text Settings.Sun}" IsChecked="{Binding Settings.Sun}" Margin="2" />
        <CheckBox Content="{a:Text Settings.SunLabel}" IsChecked="{Binding Settings.SunLabel}" IsEnabled="{Binding Settings.Sun}" Margin="2" />
        <CheckBox Content="{a:Text Settings.SunTexture}" IsChecked="{Binding Settings.SunTexture}" IsEnabled="{Binding Settings.Sun}" Margin="2" />
        <CheckBox Content="{a:Text Settings.SunFeatures}" IsChecked="{Binding Settings.SunFeatures}" IsEnabled="{Binding Settings.Sun}" Margin="2" />
        <CheckBox Content="{a:Text Settings.SunEquator}" IsChecked="{Binding Settings.SunEquator}" IsEnabled="{Binding Settings.Sun}" Margin="2" />
    </StackPanel>
</a:SettingsSection>
