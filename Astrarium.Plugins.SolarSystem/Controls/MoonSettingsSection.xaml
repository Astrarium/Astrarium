<a:SettingsSection 
    x:Class="Astrarium.Plugins.SolarSystem.Controls.MoonSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:Astrarium.Plugins.SolarSystem"
    xmlns:a="Astrarium"
    Title="{a:Text Section.Moon}"
    Icon="{StaticResource IconMoon}">
    <StackPanel Orientation="Vertical" Margin="6">
        <CheckBox Content="{a:Text Settings.Moon}" IsChecked="{Binding Settings.Moon}" Margin="2" />
        <CheckBox Content="{a:Text Settings.MoonLabel}" IsChecked="{Binding Settings.MoonLabel}" IsEnabled="{Binding Settings.Moon}" Margin="2" />
        <CheckBox Content="{a:Text Settings.MoonSurfaceFeatures}" IsChecked="{Binding Settings.MoonSurfaceFeatures}" IsEnabled="{Binding Settings.Moon}" Margin="2" />
        <GroupBox IsEnabled="{Binding Settings.Moon}" Header="{a:Text Settings.MoonTextureQuality}" Margin="6 0">
            <StackPanel Orientation="Vertical" Margin="2">
                <RadioButton Margin="2" Content="{a:Text Settings.MoonTextureQuality.Low}" GroupName="MoonTextureQuality" IsChecked="{Binding IsTextureQualityLow}"/>
                <RadioButton Margin="2" Content="{a:Text Settings.MoonTextureQuality.Normal}" GroupName="MoonTextureQuality" IsChecked="{Binding IsTextureQualityNormal}"/>
                <RadioButton Margin="2" Content="{a:Text Settings.MoonTextureQuality.High}" GroupName="MoonTextureQuality" IsChecked="{Binding IsTextureQualityHigh}"/>
            </StackPanel>
        </GroupBox>
        <CheckBox Content="{a:Text Settings.MoonMaxLibrationPoint}" IsChecked="{Binding Settings.MoonMaxLibrationPoint}" IsEnabled="{Binding Settings.Moon}" Margin="2" />
        <CheckBox Content="{a:Text Settings.MoonPrimeMeridian}" IsChecked="{Binding Settings.MoonPrimeMeridian}" IsEnabled="{Binding Settings.Moon}" Margin="2" />
        <CheckBox Content="{a:Text Settings.MoonEquator}" IsChecked="{Binding Settings.MoonEquator}" IsEnabled="{Binding Settings.Moon}" Margin="2" />
        <CheckBox Content="{a:Text Settings.EarthShadowOutline}" IsChecked="{Binding Settings.EarthShadowOutline}" Margin="2" />
    </StackPanel>
</a:SettingsSection>
