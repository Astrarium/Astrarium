<UserControl x:Class="Astrarium.Plugins.SolarSystem.Controls.UpDownSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="Astrarium">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Content="{Binding SettingTitle, FallbackValue='Setting Title'}" IsEnabled="{Binding IsEnabled}" Grid.Column="0" />
        <a:NumericUpDown Grid.Column="1" Minimum="1" Maximum="100" DecimalPlaces="0" Value="{Binding SettingValue}" IsEnabled="{Binding IsEnabled}" />
    </Grid>
</UserControl>
