<Window x:Class="Astrarium.Plugins.SolarSystem.Views.LunarCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:plugin="clr-namespace:Astrarium.Plugins.SolarSystem"
        xmlns:c="clr-namespace:Astrarium.Plugins.SolarSystem.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:Astrarium.Plugins.SolarSystem.Views"
        xmlns:vm="clr-namespace:Astrarium.Plugins.SolarSystem.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:a="Astrarium"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        WindowState="Maximized"
        Title="LunarCalendarWindow" Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <a:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />

            <SolidColorBrush x:Key="BrushIcon" Color="{Binding ColorIcon}" />
            <SolidColorBrush x:Key="BrushTextForeground" Color="{Binding ColorTextForeground}" />
            <SolidColorBrush x:Key="BrushCalendarBackground" Color="{Binding ColorCalendarBackground}" />
            <SolidColorBrush x:Key="BrushCalendarSelection" Color="{Binding ColorCalendarSelection}" />
            <SolidColorBrush x:Key="BrushCalendarForeground" Color="{Binding ColorCalendarForeground}" />
            <SolidColorBrush x:Key="BrushCalendarBorder" Color="{Binding ColorCalendarBorder}" />
            <SolidColorBrush x:Key="BrushLinkForeground" Color="{Binding ColorLinkForeground}" />

            <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Width" Value="48" />
                <Setter Property="Margin" Value="4" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushControlBackground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style  x:Key="HeaderStrip" TargetType="StackPanel">
                <Setter Property="Background" Value="{StaticResource BrushControlDarkBackground}" />
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SmallIcon" TargetType="{x:Type a:PathIcon}" BasedOn="{StaticResource {x:Type a:PathIcon}}">
                <Setter Property="Margin" Value="4 0" />
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Fill" Value="{DynamicResource BrushIcon}" />
            </Style>
           
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <StackPanel Style="{StaticResource HeaderStrip}">
            <StackPanel Margin="0" Orientation="Horizontal" HorizontalAlignment="Center" IsEnabled="{Binding IsCalculating, Converter={a:InverseBoolConverter}}">
                <Button Style="{StaticResource HeaderButton}" Command="{Binding PrevMonthCommand}">
                    <a:PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                </Button>
                <Button Style="{StaticResource HeaderButton}" Command="{Binding SelectDateCommand}" Width="220">
                    <TextBlock VerticalAlignment="Center" FontSize="28" Text="{Binding SelectedMonth}" />
                </Button>
                <Button Style="{StaticResource HeaderButton}" Command="{Binding NextMonthCommand}">
                    <a:PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                </Button>
            </StackPanel>
            <Separator Margin="0" Padding="0" />
        </StackPanel>
        
        <ScrollViewer Grid.Column="0" Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <c:LunarCalendarControl
                MinWidth="900" Margin="8" x:Name="calendarView" 
                BorderBrush="{StaticResource BrushCalendarBorder}" 
                Background="{StaticResource BrushCalendarBackground}"
                ItemsSource="{Binding Days, Mode=OneWay}"
                SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                SelectedDate="{Binding SelectedDate}" 
                Grid.Row="0">

                <c:LunarCalendarControl.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Visibility="{Binding Source={StaticResource DataContextProxy}, Path=Data.DisplayOptions.MonthHeader, Converter={a:BoolToVisibilityConverter}}" TextAlignment="Center" Background="{StaticResource BrushCalendarBackground}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="{DynamicResource BrushCalendarForeground}" Padding="0 8" Text="{Binding SelectedMonth}" />
                    </DataTemplate>
                </c:LunarCalendarControl.HeaderTemplate>
                <c:LunarCalendarControl.HeaderCellTemplate>
                    <DataTemplate>
                        <TextBlock Margin="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Stretch" Foreground="{DynamicResource BrushCalendarForeground}" Text="{Binding Path='.', Converter={a:FormatterConverter}, ConverterParameter={x:Type a:DayOfWeekFormatter}}" />
                    </DataTemplate>
                </c:LunarCalendarControl.HeaderCellTemplate>
                <c:LunarCalendarControl.DayCellTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{a:MultiEqualityConverter}">
                                                    <Binding Path="DayOfMonth"/>
                                                    <Binding Source="{StaticResource DataContextProxy}" Path="Data.SelectedDay.DayOfMonth" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{DynamicResource BrushCalendarSelection}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Child>
                                <Grid Margin="8 2" MinWidth="110" IsHitTestVisible="True"  x:Name="DayCell" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Foreground="{DynamicResource BrushCalendarForeground}" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="48" Text="{Binding DayOfMonth}" />

                                    <c:MoonDiskImageControl 
                                        Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="48" Height="48"
                                        Phase="{Binding Illumination}" 
                                        AxisRotation="{Binding PositionAngle}"
                                        RotationMode="{Binding Source={StaticResource DataContextProxy}, Path=Data.RotationMode}"
                                        NightMode="{Binding Source={StaticResource DataContextProxy}, Path=Data.NightMode}"
                                        UseImage="{Binding Source={StaticResource DataContextProxy}, Path=Data.DisplayOptions.MoonImages}"/>

                                    <a:PathIcon Grid.Row="1" Grid.Column="0" Data="{StaticResource PathSunRise}" Style="{StaticResource SmallIcon}">
                                        <a:PathIcon.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.Icons" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunRise" />
                                            </MultiBinding>
                                        </a:PathIcon.Visibility>
                                    </a:PathIcon>
                                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunRise" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <Hyperlink Foreground="{DynamicResource BrushLinkForeground}" IsEnabled="{Binding Sun.Rise, Converter={a:NotNanToBoolConverter}}" Command="{Binding Source={StaticResource DataContextProxy}, Path=Data.ShowSunRiseCommand}" CommandParameter="{Binding DayOfMonth}">
                                            <Run Text="{Binding Sun.Rise, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:TimeFormatter}}" />
                                        </Hyperlink>
                                    </TextBlock>

                                    <a:PathIcon Grid.Row="2" Grid.Column="0" Data="{StaticResource PathDuration}" Style="{StaticResource SmallIcon}">
                                        <a:PathIcon.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.Icons" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.DayLength" />
                                            </MultiBinding>
                                        </a:PathIcon.Visibility>
                                    </a:PathIcon>

                                    <TextBlock Foreground="{DynamicResource BrushTextForeground}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Text="{Binding Sun.Duration, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:DurationFormatter}}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.DayLength" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>

                                    <a:PathIcon Grid.Row="3" Grid.Column="0" Data="{StaticResource PathSunSet}"  Style="{StaticResource SmallIcon}">
                                        <a:PathIcon.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.Icons" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunSet" />
                                            </MultiBinding>
                                        </a:PathIcon.Visibility>
                                    </a:PathIcon>

                                    <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.SunSet" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <Hyperlink Foreground="{DynamicResource BrushLinkForeground}" IsEnabled="{Binding Sun.Set, Converter={a:NotNanToBoolConverter}}" Command="{Binding Source={StaticResource DataContextProxy}, Path=Data.ShowSunSetCommand}" CommandParameter="{Binding DayOfMonth}">
                                            <Run Text="{Binding Sun.Set, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:TimeFormatter}}" />
                                        </Hyperlink>
                                    </TextBlock>

                                    <a:PathIcon HorizontalAlignment="Right"  Grid.Row="1" Grid.Column="2" Data="{StaticResource PathMoonRise}" Style="{StaticResource SmallIcon}">
                                        <a:PathIcon.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.Icons" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonRise" />
                                            </MultiBinding>
                                        </a:PathIcon.Visibility>
                                    </a:PathIcon>

                                    <TextBlock Grid.Row="1" Grid.Column="3" HorizontalAlignment="Right">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonRise" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <Hyperlink Foreground="{DynamicResource BrushLinkForeground}" IsEnabled="{Binding Moon.Rise, Converter={a:NotNanToBoolConverter}}" Command="{Binding Source={StaticResource DataContextProxy}, Path=Data.ShowMoonRiseCommand}" CommandParameter="{Binding DayOfMonth}">
                                            <Run Text="{Binding Moon.Rise, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:TimeFormatter}}" />
                                        </Hyperlink>
                                    </TextBlock>

                                    <a:PathIcon ToolTip="Lunar transit (culmination)" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="2" Data="{StaticResource PathTransit}" Style="{StaticResource SmallIcon}">
                                        <a:PathIcon.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.Icons" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonTransit" />
                                            </MultiBinding>
                                        </a:PathIcon.Visibility>
                                    </a:PathIcon>

                                    <TextBlock Grid.Row="2" Grid.Column="3" HorizontalAlignment="Right">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonTransit" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <Hyperlink Foreground="{DynamicResource BrushLinkForeground}" IsEnabled="{Binding Moon.Transit, Converter={a:NotNanToBoolConverter}}" Command="{Binding Source={StaticResource DataContextProxy}, Path=Data.ShowMoonTransitCommand}" CommandParameter="{Binding DayOfMonth}">
                                            <Run Text="{Binding Moon.Transit, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:TimeFormatter}}" />
                                        </Hyperlink>
                                    </TextBlock>

                                    <a:PathIcon HorizontalAlignment="Right" Grid.Row="3" Grid.Column="2" Data="{StaticResource PathMoonSet}" Style="{StaticResource SmallIcon}">
                                        <a:PathIcon.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.Icons" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonSet" />
                                            </MultiBinding>
                                        </a:PathIcon.Visibility>
                                    </a:PathIcon>

                                    <TextBlock Grid.Row="3" Grid.Column="3" HorizontalAlignment="Right">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{a:MultiBoolToVisibilityConverter}">
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonInfo" />
                                                <Binding Source="{StaticResource DataContextProxy}" Path="Data.DisplayOptions.MoonSet" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <Hyperlink Foreground="{DynamicResource BrushLinkForeground}" IsEnabled="{Binding Moon.Set, Converter={a:NotNanToBoolConverter}}" Command="{Binding Source={StaticResource DataContextProxy}, Path=Data.ShowMoonSetCommand}" CommandParameter="{Binding DayOfMonth}">
                                            <Run Text="{Binding Moon.Set, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:TimeFormatter}}" />
                                        </Hyperlink>
                                    </TextBlock>

                                    <StackPanel HorizontalAlignment="Center" Margin="0 4" Visibility="{Binding Phase, Converter={a:NotNullToVisibilityConverter}}" Orientation="Horizontal" Grid.Row="4" Grid.ColumnSpan="4">
                                        <TextBlock Foreground="{DynamicResource BrushTextForeground}" Text="{Binding Phase, Converter={a:FormatterConverter}, ConverterParameter={x:Type plugin:LunarPhaseTextFormatter}}" HorizontalAlignment="Center" />
                                        <TextBlock Text=": " Foreground="{DynamicResource BrushTextForeground}" />
                                        <TextBlock>
                                            <Hyperlink Foreground="{DynamicResource BrushLinkForeground}" Command="{Binding Source={StaticResource DataContextProxy}, Path=Data.ShowMoonCommand}" CommandParameter="{Binding PhaseInstant}">
                                                <Run Text="{Binding PhaseInstant, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:TimeFormatter}}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>

                                </Grid>
                            </Border.Child>
                        </Border>
                    </DataTemplate>
                </c:LunarCalendarControl.DayCellTemplate>
            </c:LunarCalendarControl>
        </ScrollViewer>
        
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" ResizeDirection="Columns" Width="5"  ResizeBehavior="PreviousAndNext" />

        <TabControl  
              MinWidth="400" 
              Width="Auto" 
              Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
              HorizontalAlignment="Stretch">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Export" Margin="4" TextAlignment="Center" VerticalAlignment="Center" />
                </TabItem.Header>
                <StackPanel Orientation="Vertical">
                    <GroupBox Header="Display" Margin="4 0">
                        <StackPanel Orientation="Vertical" Margin="4">
                            <CheckBox IsChecked="{Binding DisplayOptions.PrintMode}" Content="Print mode" />
                            <CheckBox IsChecked="{Binding DisplayOptions.MonthHeader}" Content="Month header" />
                            <CheckBox IsChecked="{Binding DisplayOptions.MoonImages}" Content="Use Moon images" />
                            <CheckBox IsChecked="{Binding DisplayOptions.Icons}" Content="Icons" />

                            <CheckBox Name="SunInfo" IsChecked="{Binding DisplayOptions.SunInfo}" Content="Sun info" />
                            <StackPanel Orientation="Vertical" Margin="16 0 0 0" IsEnabled="{Binding ElementName=SunInfo, Path=IsChecked}">
                                <CheckBox IsChecked="{Binding DisplayOptions.SunRise}" Content="Rise" />
                                <CheckBox IsChecked="{Binding DisplayOptions.DayLength}" Content="Day length" />
                                <CheckBox IsChecked="{Binding DisplayOptions.SunSet}" Content="Set" />
                            </StackPanel>

                            <CheckBox Name="MoonInfo" IsChecked="{Binding DisplayOptions.MoonInfo}" Content="Moon info" />
                            <StackPanel Orientation="Vertical" Margin="16 0 0 0" IsEnabled="{Binding ElementName=MoonInfo, Path=IsChecked}">
                                <CheckBox IsChecked="{Binding DisplayOptions.MoonRise}" Content="Rise" />
                                <CheckBox IsChecked="{Binding DisplayOptions.MoonTransit}" Content="Transit time" />
                                <CheckBox IsChecked="{Binding DisplayOptions.MoonSet}" Content="Set" />
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Rotation" Margin="4 0">
                        <StackPanel Orientation="Vertical" Margin="4">
                            <RadioButton Content="PA" IsChecked="{Binding Source={StaticResource DataContextProxy}, Path=Data.RotationMode, Converter={a:EqualityConverter}, ConverterParameter={x:Static c:MoonDiskImageRotationMode.PA}}" />
                            <RadioButton Content="North top" IsChecked="{Binding Source={StaticResource DataContextProxy}, Path=Data.RotationMode, Converter={a:EqualityConverter}, ConverterParameter={x:Static c:MoonDiskImageRotationMode.NorthTop}}" />
                            <RadioButton Content="South top" IsChecked="{Binding Source={StaticResource DataContextProxy}, Path=Data.RotationMode,Converter={a:EqualityConverter}, ConverterParameter={x:Static c:MoonDiskImageRotationMode.SouthTop}}" />
                        </StackPanel>
                    </GroupBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Margin="4 8" Command="{Binding ExportCommand}" CommandParameter="{Binding ElementName=calendarView}">
                            <StackPanel Orientation="Horizontal">
                                <a:PathIcon Margin="8 0" Data="M14,2L20,8V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2H14M18,20V9H13V4H6V20H18M17,13V19H7L12,14L14,16M10,10.5A1.5,1.5 0 0,1 8.5,12A1.5,1.5 0 0,1 7,10.5A1.5,1.5 0 0,1 8.5,9A1.5,1.5 0 0,1 10,10.5Z" />
                                <TextBlock Text="Save as image..." />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Margin="4 8" Command="{Binding PrintCommand}" CommandParameter="{Binding ElementName=calendarView}">
                            <StackPanel Orientation="Horizontal">
                                <a:PathIcon Margin="8 0" Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z" />
                                <TextBlock Text="Print..." />
                            </StackPanel>
                        </Button>

                    </Grid>

                </StackPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Details" Margin="4" TextAlignment="Center" VerticalAlignment="Center" />
                </TabItem.Header>
                <Grid>

                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding SelectedInstant, Converter={a:NullToVisibilityConverter}}">
                        <TextBlock IsEnabled="False" Text="Select a day from the calendar to see details" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Visibility="{Binding SelectedInstant, Converter={a:NotNullToVisibilityConverter}}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource HeaderButton}" Grid.Column="0" Grid.Row="0" Command="{Binding PrevDayCommand}" IsEnabled="{Binding IsCalculating, Converter={a:InverseBoolConverter}}">
                            <a:PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                        </Button>

                        <Button Style="{StaticResource HeaderButton}" Grid.Column="2" Grid.Row="0" Command="{Binding NextDayCommand}" IsEnabled="{Binding IsCalculating, Converter={a:InverseBoolConverter}}">
                            <a:PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                        </Button>

                        <c:MoonDiskImageControl 
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8"
                            DataContext="{Binding SelectedInstant}"
                            Width="128" Height="128"
                            HorizontalAlignment="Center"
                            Phase="{Binding Illumination}" 
                            AxisRotation="{Binding PositionAngle}"
                            RotationMode="{Binding Source={StaticResource DataContextProxy}, Path=Data.RotationMode}"
                            NightMode="{Binding Source={StaticResource DataContextProxy}, Path=Data.NightMode}"
                            UseImage="{Binding Source={StaticResource DataContextProxy}, Path=Data.DisplayOptions.MoonImages}"/>

                        <!-- Time control -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="8 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <c:LunarVisibilityChart Margin="4 0" Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Width="Auto" Height="40" Background="{StaticResource BrushControlDarkBackground}"
                                SunCoordinates="{Binding SelectedInstant.SunCoordinates, Mode=OneWay}" 
                                MoonRiseTransitSet="{Binding SelectedInstant.Moon, Mode=OneWay}"
                                SiderealTime="{Binding SelectedInstant.SiderealTime, Mode=OneWay}"
                                GeoLocation="{Binding GeoLocation, Mode=OneWay}"
                                Position="{Binding ElementName=slider, Path=Value, Mode=TwoWay}"
                                IsDarkMode="{Binding Source={StaticResource DataContextProxy}, Path=Data.NightMode}"/>

                            <Slider Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Width="Auto" Margin="0 55 0 0" x:Name="slider"  Minimum="0" Maximum="0.999999999" SmallChange="6.95e-4" LargeChange="0.04166666" Value="{Binding SelectedTimeOfTheDay, Mode=TwoWay}"  />

                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center">
                                <TextBlock  HorizontalAlignment="Center" Text="{Binding ElementName=slider, Path=Value, Converter={a:FormatterConverter}, ConverterParameter={x:Type a:TimeFormatter}}" />
                            </StackPanel>

                        </Grid>

                        <ScrollViewer Grid.Row="2" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto">

                            <ItemsControl 
                                 Grid.IsSharedSizeScope="True" Margin="8"
                                 ItemsSource="{Binding Source={StaticResource DataContextProxy}, Path=Data.SelectedInstant.Ephemerides}" 
                                 VirtualizingPanel.IsVirtualizing="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="Key" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition SharedSizeGroup="Value" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Key, Converter={a:LocalizedTextConverter}, ConverterParameter='$Moon.'}" />
                                                <TextBlock Grid.Column="1" Padding="4" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock.Text>
                                                        <MultiBinding Mode="OneWay" Converter="{a:MultiValueFormatterConverter}">
                                                            <Binding Path="Value" />
                                                            <Binding Path="Formatter" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
