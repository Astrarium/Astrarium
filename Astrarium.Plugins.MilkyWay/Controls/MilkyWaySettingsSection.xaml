<a:SettingsSection 
    x:Class="Astrarium.Plugins.MilkyWay.Controls.MilkyWaySettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:a="Astrarium"
    Title="{a:Text Section.MilkyWay}"
    Icon="{StaticResource IconMilkyWay}"
    mc:Ignorable="d"
    d:DesignHeight="450" 
    d:DesignWidth="800">
    <StackPanel Orientation="Vertical" Margin="6">
        <CheckBox Content="{a:Text Settings.MilkyWay}" IsChecked="{Binding Settings.MilkyWay}" Margin="2" />
        <CheckBox Content="{a:Text Settings.MilkyWayDimOnZoom}" IsChecked="{Binding Settings.MilkyWayDimOnZoom}" IsEnabled="{Binding Settings.MilkyWay}" Margin="2" />
    </StackPanel>
</a:SettingsSection>
