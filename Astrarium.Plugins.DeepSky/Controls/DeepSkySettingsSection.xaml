<a:SettingsSection 
    x:Class="Astrarium.Plugins.DeepSky.Controls.DeepSkySettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:a="Astrarium"
    Title="{a:Text Section.DeepSky}"
    Icon="{StaticResource IconDeepSky}"
    mc:Ignorable="d"
    d:DesignHeight="450" 
    d:DesignWidth="800">

    <StackPanel Orientation="Vertical" Margin="6" IsEnabled="{Binding IsEnabled}">

        <CheckBox Content="{a:Text Settings.DeepSky}" IsChecked="{Binding Settings.DeepSky}" Margin="2" />
        <StackPanel Orientation="Vertical" IsEnabled="{Binding Settings.DeepSky}">
            <CheckBox Content="{a:Text Settings.DeepSkyDisplayRegardlessMag}" IsChecked="{Binding Settings.DeepSkyDisplayRegardlessMag}" Margin="2" />
            <CheckBox Content="{a:Text Settings.DeepSkyHideUnknown}" IsChecked="{Binding Settings.DeepSkyHideUnknown}" Margin="2" />
            <CheckBox Content="{a:Text Settings.DeepSkyLabels}" IsChecked="{Binding Settings.DeepSkyLabels}" Margin="2" />
            <CheckBox Content="{a:Text Settings.DeepSkyImages}" IsChecked="{Binding Settings.DeepSkyImages}" Margin="2" />
            <CheckBox Content="{a:Text Settings.DeepSkyHideOutline}" IsChecked="{Binding Settings.DeepSkyHideOutline}" Margin="2" />
            <CheckBox Content="{a:Text Settings.DeepSkyHoverOutline}" IsChecked="{Binding Settings.DeepSkyHoverOutline}" IsEnabled="{Binding Settings.DeepSkyHideOutline}" Margin="2" />
        </StackPanel>

        <StackPanel Orientation="Vertical" IsEnabled="{Binding Settings.DeepSkyImages}">
            <TextBlock Margin="2 8 2 2" Text="{a:Text Settings.DeepSky.ImagesFolder.Title}" />
            <a:FilePathPicker Caption="{a:Text Settings.DeepSky.ImagesFolder.DialogCaption}" Mode="Directory" SelectedPath="{Binding Settings.DeepSkyImagesFolder}" Validator="{Binding ValidateImagesPath}" />

            <TextBlock Margin="2 8 2 2" TextWrapping="Wrap" Text="{Binding ImagesState}" />
            
            <StackPanel Orientation="Vertical" Visibility="{Binding ImagesFound, Converter={a:InverseBoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{a:Text DeepSkyImages.DownloadAutoButton}" Command="{Binding DownloadImagesCommand}" MinWidth="100" Padding="8 0" Margin="0 8 0 0" Width="Auto" HorizontalAlignment="Left" />
                    <Button Content="{a:Text DeepSkyImages.DownloadManualButton}" Command="{Binding OpenImagesUrlCommand}" MinWidth="100" Padding="8 0" Margin="4 8 0 0" Width="Auto" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </StackPanel>
</a:SettingsSection>
