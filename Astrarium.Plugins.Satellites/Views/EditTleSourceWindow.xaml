<Window x:Class="Astrarium.Plugins.Satellites.Views.EditTleSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="Astrarium"
        Style="{StaticResource {x:Type Window}}"
        Title="{a:Text EditTLESourceWindow.Title}" 
        MinWidth="300"
        MinHeight="300"
        Height="400" Width="600">
    <Grid Margin="4" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0">

            <CheckBox Margin="4" IsChecked="{Binding IsEnabled}" Content="{a:Text Settings.SatellitesOrbitalElementsSources.IsEnabled}" />

            <Label Content="{a:Text Settings.SatellitesOrbitalElementsSources.Name}" />
            <TextBox Text="{Binding FileName}" />

            <Label Content="{a:Text Settings.SatellitesOrbitalElementsSources.Url}" />
            <TextBox Text="{Binding Url}" />
        </StackPanel>

        <Separator Grid.Row="1" Margin="0 4 0 4" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="80" Width="Auto" Margin="4 0 0 0" Padding="8 2" Command="{Binding OkCommand}" Content="{a:Text OK}" />
            <Button MinWidth="80" Width="Auto" Margin="4 0 0 0" Padding="8 2" Command="{Binding CancelCommand}" Content="{a:Text Cancel}" />
        </StackPanel>
    </Grid>
</Window>
